<?xml version="1.0" encoding="utf-8"?>
<!--
  A lens, and an arrow leaving it downward into the tray of a roll.

  Line art only, no fills beyond the arrowhead: LightOS renders the launcher in greyscale on a
  reflective panel, where a solid glyph turns into a blob and a stroked one stays readable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the lens -->
    <path
        android:pathData="M 34.0,40.0 A 20.0,20.0 0 1 0 74.0,40.0 A 20.0,20.0 0 1 0 34.0,40.0 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 45.0,40.0 A 9.0,9.0 0 1 0 63.0,40.0 A 9.0,9.0 0 1 0 45.0,40.0 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <!-- the transfer -->
    <path
        android:pathData="M 54.0,64.0 L 54.0,80.0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 45.0,73.0 L 54.0,82.0 L 63.0,73.0 Z"
        android:fillColor="#FFFFFF" />

    <!-- the roll it lands in -->
    <path
        android:pathData="M 28.0,88.0 L 80.0,88.0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
